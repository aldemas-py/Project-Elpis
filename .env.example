# ============================================================
# Elpis Counselling Centre - Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit the `.env` file (it is git-ignored).
# In production you may instead set these as real environment
# variables (which take precedence over this file).

# --- Database ---
DB_HOST=localhost
DB_NAME=elpis_counselling
DB_USER=root
DB_PASS=

# --- Site ---
# Set APP_URL to your canonical production URL (no trailing slash)
APP_URL=http://localhost/work_folder/Project-Elpis
SITE_NAME=Elpis Counselling Centre
ADMIN_EMAIL=elpiscounselling24@gmail.com

# --- SMTP (email) ---
# For Gmail with 2FA, generate a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=elpiscounselling24@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=elpiscounselling24@gmail.com
SMTP_FROM_NAME=Elpis Counselling Centre

# --- M-Pesa Daraja API ---
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
